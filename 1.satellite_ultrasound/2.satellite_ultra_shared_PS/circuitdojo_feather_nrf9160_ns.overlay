// *************************** Iridium: uart2 - S **************************
&pinctrl {
    uart2_default: uart2_default {
        group1 {
                psels = <NRF_PSEL(UART_TX, 0, 23)>,            // Blue
                        <NRF_PSEL(UART_RX, 0, 24)>;            // Green
        };
    };

    uart2_sleep: uart2_sleep {
        group1 {
                psels = <NRF_PSEL(UART_TX, 0, 23)>,            // Blue
                        <NRF_PSEL(UART_RX, 0, 24)>;            // Green
                low-power-enable;
        };
    };
};

&uart2{
    status = "okay";
    current-speed = <19200>;  // Iridium 9603 baud rate is 19200bps
};
// *************************** Iridium: uart2 - E **************************


// *************************** Ultrasound sensor: uart3 - S **************************

&spi3 {
    status = "disabled";        // Used by external flash by default
};

&pinctrl {
    uart3_default: uart3_default {
        group1 {
                psels = <NRF_PSEL(UART_TX, 0, 31)>,            // Blue
                        <NRF_PSEL(UART_RX, 0, 19)>;            // Green
        };
    };

    uart3_sleep: uart3_sleep {
        group1 {
                psels = <NRF_PSEL(UART_TX, 0, 31)>,            // Blue
                        <NRF_PSEL(UART_RX, 0, 19)>;            // Green
                low-power-enable;
        };
    };
};

&uart3{
    status = "okay";
    current-speed = <9600>;  // Sensor baud rate is 9600bps
    
    pinctrl-0 = <&uart3_default>;
    pinctrl-1 = <&uart3_sleep>;
    pinctrl-names = "default", "sleep";
};
// *************************** Ultrasound sensor: uart1 - E **************************


/* ======================================================================== */
//*************************** ADC Config. for READING Vpv - S **************************
/ {
	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
    
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		
        zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN1>; // P0.04
		
        zephyr,resolution = <12>;
	};
};

//********************  ADC Config. for READING Vpv - E **********************



//**************** Turn OFF DS isolating the solar panel when V > Vmax or measuring Vsolar (S2) *****************
/{    
    OpenCircuit_sw{
		compatible = "gpio-leds";
        label = "Digital Switch for isolating solar Panel";
		OpenCircuit: pv_pannel_switch{
			gpios = <&gpio0 22 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
            label = "Digital Switch for isolating solar Panel when V > Vmax";
		};
    };

    aliases {
        opencircuit = &OpenCircuit;
    };
};
//***************** Turn OFF DS isolating the solar panel when V > Vmax or measuring Vsolar (S2) - E ****************


//********************* Enable/Disable the divider of V_solar reading (S1) - S ******************** 
/{  
    Vpv_divider_sw{
		compatible = "gpio-leds";
        label = "Digital Switch for enabling/disabling the divider of V_solar reading";
		divider: Vpv_divider_sw{
            gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "Digital Switch for enable/disable the divider of V_solar reading";
		};
    };
    
    aliases {
        vpvdividersw = &divider;
    };
};
//***************** Enable/Disable the divider of V_solar reading (S1) - E ******************


// *************************** Control digital Switch to power down peripherals - S3 **************************
/{    
    peripheral_power_sw{
		compatible = "gpio-leds";
        label = "Control digital Switch to power down peripherals";
		PERIPH_SW: peripheral_power_sw {
			gpios = <&gpio0 4 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;            // Pin 4; High level when pin is set
			label = "Control digital Switch to power down peripherals";
		};
    };
    
    aliases {
        periphsw = &PERIPH_SW;                  // Switch for powering down peripherals
    };
};
// *************************** Control digital Switch to power down peripherals - S3 **************************



// ******************** Ultra Low power (Circuit Dojo's) - S ********************
/{
    zephyr,user {
        latch-en-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
        wp-gpios = < &gpio0 8 GPIO_ACTIVE_LOW >;
        hold-gpios = < &gpio0 10 GPIO_ACTIVE_LOW >;
    };

    leds {
        compatible = "gpio-leds";
        blue_led: led_0 {
            // gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
            gpios = <&gpio0 3 GPIO_PULL_DOWN>;
            label = "Blue LED (D7)";
        };
    };
};
    
// Turn off GPIO0 when sleeping - reduce by 150uA
&gpio0 {
    sense-edge-mask = <0xffff>;
};

// Isolate sdo and sa0 pins - reduce leakage current of around 140uA 
&i2c1 {
    lis2dh@18 {
        compatible = "st,lis2dh";
        reg = <0x18>;
        disconnect-sdo-sa0-pull-up;
    };
};
    
&spi3 {
    w25q32jv: w25q32jv@0 {
        /delete-property/ wp-gpios;
        /delete-property/ hold-gpios;
        t-enter-dpd = < 3500 >;
        t-exit-dpd = < 3500 >;
    };
};
// Stop - ******************** Ultra Low power (Circuit Dojo's) - E ********************